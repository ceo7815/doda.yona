# דודה יונה — משתני סביבה (העתיקו ל-.env.local ומלאו)

# כתובת האתר (ל-canonical, sitemap ו-OG)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_RESTAURANT_NAME=דודה יונה

# Supabase — פרויקט האתר (מפתח anon בלבד; ציבורי מטבעו, מוגן ב-RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# קישור לדף ההזמנות של הקופה (אפשר גם לעדכן באדמין → הזמנות והגדרות).
# כל עוד ריק — כפתורי ההזמנה מחייגים למסעדה.
NEXT_PUBLIC_ORDER_URL=

# 1 = noindex לכל האתר (לסביבות תצוגה מקדימה)
NEXT_PUBLIC_NOINDEX=

# 1 = ביטול אופטימיזציית תמונות של Next (לאירוח שאין בו image optimizer)
NEXT_IMAGE_UNOPTIMIZED=
